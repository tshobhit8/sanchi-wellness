---
layout: layouts/base.njk
---
<!-- Article Header -->
<section class="pt-10 pb-8 md:pt-14 md:pb-10 px-margin-mobile md:px-gutter max-w-container-max mx-auto">
<a class="inline-flex items-center gap-1 text-sm text-interactive-blue hover:opacity-80 transition-opacity mb-6" href="/blogs/">
<span class="material-symbols-outlined text-[18px]">arrow_back</span> Back to Blog
</a>
<span class="inline-block px-3 py-1 bg-secondary-container text-on-secondary-container font-label-caps text-label-caps rounded-full mb-4">{{ category }}</span>
<h1 class="font-display-lg-mobile md:font-display-lg text-3xl md:text-5xl text-primary mb-4 leading-tight">{{ title }}</h1>
<p class="text-sm text-on-surface-variant mb-8">Published {{ date | readableDate }} &middot; {{ readTime }}</p>
<div class="aspect-[16/7] rounded-2xl overflow-hidden border border-border-subtle shadow-sm">
<img alt="{{ heroImageAlt }}" class="w-full h-full object-cover" src="{{ heroImage }}"/>
</div>
</section>
<!-- TOC + Content -->
<section class="pb-section-gap-mobile md:pb-section-gap-desktop px-margin-mobile md:px-gutter max-w-container-max mx-auto">
<div class="grid grid-cols-1 lg:grid-cols-12 gap-10">
<!-- Table of Contents -->
<aside class="lg:col-span-3">
<div class="lg:sticky lg:top-24 bg-surface-container rounded-xl border border-border-subtle p-6">
<h2 class="text-xs uppercase tracking-widest font-semibold text-text-main mb-4">Table of Contents</h2>
<nav class="space-y-3 text-sm">
{% for item in toc %}
<a class="block text-on-surface-variant hover:text-primary transition-colors" href="#{{ item.id }}">{{ loop.index }}. {{ item.title }}</a>
{% endfor %}
</nav>
</div>
</aside>
<!-- Content -->
<div class="lg:col-span-9">
<div class="grid grid-cols-1 md:grid-cols-3 gap-10">
<div class="md:col-span-2 prose prose-lg max-w-none
  prose-headings:font-serif prose-headings:text-primary
  prose-h2:text-2xl prose-h2:font-semibold prose-h2:mb-3 prose-h2:mt-10 first:prose-h2:mt-0
  prose-p:text-on-surface-variant prose-p:leading-relaxed
  prose-a:text-accent-green prose-a:no-underline hover:prose-a:underline
  prose-strong:text-primary prose-strong:font-semibold">
{{ content | safe }}
{% if ctaText %}
<div class="pt-6 border-t border-border-subtle">
<p class="font-body-md">{{ ctaText }} <a class="text-accent-green underline hover:text-primary transition-colors" href="{{ ctaLinkHref }}">{{ ctaLinkText }}</a> or <a class="text-accent-green underline hover:text-primary transition-colors" href="/#lead-form">book a free consultation</a>.</p>
</div>
{% endif %}
</div>
<!-- Images -->
<div class="md:col-span-1">
<div class="md:sticky md:top-24 space-y-6">
{% for img in sidebarImages %}
<div class="aspect-[4/5] rounded-xl overflow-hidden border border-border-subtle shadow-sm">
<img alt="{{ img.alt }}" class="w-full h-full object-cover" src="{{ img.src }}"/>
</div>
{% endfor %}
</div>
</div>
</div>
</div>
</div>
</section>
<!-- Related / More Blogs CTA -->
<section class="bg-surface-container-low py-16 px-margin-mobile md:px-gutter border-t border-border-subtle text-center">
<div class="max-w-container-max mx-auto">
<h2 class="font-headline-md-mobile md:font-headline-md text-primary mb-6">Read More From Our Blog</h2>
<a class="inline-flex items-center gap-2 font-label-caps text-label-caps bg-primary-container text-on-primary px-8 py-4 rounded hover:bg-primary transition-colors" href="/blogs/">
                    View All Articles <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
</a>
</div>
</section>
