---
layout: layouts/base.njk
---
<!-- Breadcrumb -->
<nav class="max-w-[760px] mx-auto px-6 pt-5 text-[13px] text-ink-muted flex items-center gap-2">
<a class="text-inherit no-underline hover:text-accent-text-dark" href="/">Home</a><span>/</span>
<a class="text-inherit no-underline hover:text-accent-text-dark" href="/blogs/">Blog</a><span>/</span>
<span class="text-ink font-semibold">{{ category }}</span>
</nav>

<!-- ARTICLE HEADER -->
<section class="max-w-[760px] mx-auto px-6 pt-6 pb-6">
<div class="inline-block bg-accent-light text-accent-text-dark px-3.5 py-1.5 rounded-full text-[12.5px] font-semibold mb-5">{{ category }}</div>
<h1 class="font-display text-3xl md:text-[40px] leading-[1.2] font-semibold mb-5">{{ title }}</h1>
<p class="text-[17px] text-ink-muted mb-7">{{ description }}</p>
<div class="flex items-center gap-3 py-4 border-t border-b border-hairline">
<img alt="Sanchi Singh" class="w-11 h-11 rounded-full object-cover" src="/assets/images/sanchi-avatar.jpg"/>
<div>
<a class="font-bold text-sm text-ink no-underline hover:underline" href="/about/">Sanchi Singh</a>
<div class="text-[12.5px] text-ink-muted">Published {{ date | readableDate }} · {{ readTime }}</div>
</div>
</div>
</section>

<!-- FEATURED IMAGE -->
<section class="max-w-[960px] mx-auto px-6 pb-10">
<img alt="{{ heroImageAlt }}" class="w-full aspect-video object-cover rounded-2xl" src="{{ heroImage }}"/>
</section>

<!-- BODY -->
<section class="max-w-[760px] mx-auto px-6 pb-14">
<div class="article-body prose prose-lg max-w-none
  prose-headings:font-display prose-headings:text-ink
  prose-h2:text-2xl prose-h2:font-semibold prose-h2:mb-3.5 prose-h2:mt-9 first:prose-h2:mt-0
  prose-p:text-ink-muted prose-p:leading-relaxed
  prose-a:text-accent-text-dark prose-a:no-underline hover:prose-a:underline
  prose-strong:text-ink prose-strong:font-semibold
  prose-li:text-ink-muted">
{{ content | safe }}
</div>
{% if ctaText %}
<div class="pt-6 border-t border-hairline">
<p class="text-[15px]">{{ ctaText }} <a class="text-accent-text-dark underline" href="{{ ctaLinkHref }}">{{ ctaLinkText }}</a> or <a class="text-accent-text-dark underline" href="/#lead-form">book a free consultation</a>.</p>
</div>
{% endif %}
</section>

<!-- AUTHOR BOX -->
<section class="max-w-[760px] mx-auto px-6 pb-6">
<div class="bg-paper-soft rounded-2xl p-7 flex gap-4.5 items-center">
<img alt="Sanchi Singh" class="w-16 h-16 rounded-full object-cover shrink-0" src="/assets/images/sanchi-avatar.jpg"/>
<div>
<a class="font-bold text-[15px] mb-1 text-ink no-underline hover:underline block" href="/about/">Written by Sanchi Singh, M.Sc. Clinical Nutrition</a>
<p class="text-[13.5px] text-ink-muted m-0">Nutrition coach with 5+ years of experience helping Indian families manage weight, PCOD, diabetes and thyroid conditions through practical, home-cooked meal plans, delivered entirely online.</p>
</div>
</div>
</section>

<!-- DISCLAIMER -->
<section class="max-w-[760px] mx-auto px-6 pb-14">
<p class="text-[12px] text-ink-muted opacity-70 leading-relaxed m-0">This article is for general nutrition education and does not replace individualized medical advice. Please consult your physician before making changes to your diet, especially if you have an existing medical condition.</p>
</section>

<!-- CTA -->
<section class="max-w-[760px] mx-auto px-6 pb-14">
<div class="bg-accent-dark rounded-[20px] p-10 text-center text-white">
<h2 class="font-display text-2xl font-semibold mb-2.5">Want a plan built around your needs?</h2>
<p class="text-[14.5px] opacity-80 mb-5">Get a free consultation and a sample meal plan tailored to your condition.</p>
<a class="bg-card text-accent-dark px-6 py-3.5 rounded-lg no-underline font-bold text-[14.5px]" href="/#lead-form">Book Free Consultation</a>
</div>
</section>

<!-- RELATED -->
<section class="max-w-[1000px] mx-auto px-6 pb-16 md:pb-20">
<h2 class="font-display text-2xl font-semibold mb-6">Related Articles</h2>
<div class="grid grid-cols-1 md:grid-cols-3 gap-5 grid-3">
{% for post in collections.blogPosts %}
{% if post.url != page.url and loop.index <= 3 %}
<a class="no-underline text-inherit bg-card border border-hairline rounded-2xl overflow-hidden flex flex-col" href="{{ post.url }}">
<img alt="{{ post.data.heroImageAlt }}" class="w-full h-[130px] object-cover" src="{{ post.data.heroImage }}"/>
<div class="p-4">
<div class="font-display text-[15px] font-semibold leading-tight">{{ post.data.title }}</div>
</div>
</a>
{% endif %}
{% endfor %}
</div>
</section>
