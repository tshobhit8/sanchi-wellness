<style>
        /* 2026 redesign palette. Change --color-accent / --color-warm here to
           re-theme the whole site — every derived shade below follows automatically. */
        :root {
            --color-accent: #16a34a;
            --color-warm: #ea580c;
            --color-accent-light: color-mix(in srgb, var(--color-accent) 14%, white);
            --color-accent-text-dark: color-mix(in srgb, var(--color-accent) 75%, black);
            --color-accent-dark: color-mix(in srgb, var(--color-accent) 45%, black);
            --color-ink: oklch(22% 0.015 75);
            --color-ink-muted: oklch(42% 0.02 75);
            --color-paper: oklch(98% 0.012 75);
            --color-paper-soft: oklch(96% 0.015 80);
            --color-paper-warm: oklch(96% 0.03 45);
            --color-card: oklch(99% 0.01 90);
            --color-hairline: oklch(88% 0.015 75);
            --color-footer-ink: oklch(20% 0.015 75);
            --color-gold-star: oklch(58% 0.13 70);
        }
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }
        html { scroll-behavior: smooth; }
        body { background: var(--color-paper); }
        .card-border {
            border: 1px solid #E7E2D7;
        }
        .soft-shadow {
            box-shadow: 0px 4px 20px rgba(18, 60, 92, 0.08);
        }
        .text-gradient {
            background: linear-gradient(90deg, #5B8C3A, #C9922E);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        .faq-answer {
            max-height: 0;
            overflow: hidden;
            transition: max-height 0.3s ease-out, opacity 0.3s ease-out, padding 0.3s ease-out;
            opacity: 0;
            padding-top: 0;
            padding-bottom: 0;
        }
        .faq-item.active .faq-answer {
            max-height: 500px;
            opacity: 1;
            padding-top: 8px;
            padding-bottom: 22px;
        }
        .faq-item.active { border-color: var(--color-accent) !important; box-shadow: 0 12px 28px oklch(20% 0.02 75 / 0.08); }
        .faq-item.active .faq-toggle { transform: rotate(45deg); }
        .faq-toggle { transition: transform 0.2s ease; }
        .card-hover { transition: box-shadow .2s ease; }
        .card-hover:hover { box-shadow: 0 16px 36px oklch(20% 0.02 75 / 0.12); }
        .carousel-track { scrollbar-width: none; -ms-overflow-style: none; }
        .carousel-track::-webkit-scrollbar { display: none; }
        @media (max-width: 760px) {
            .main-nav { display: none !important; }
            .utility-bar { display: none !important; }
            .grid-2 { grid-template-columns: 1fr !important; }
            .grid-3 { grid-template-columns: 1fr !important; }
            .grid-5 { grid-template-columns: repeat(2, 1fr) !important; }
            .stack-grid { grid-template-columns: 1fr !important; }
            .footer-grid { grid-template-columns: 1fr 1fr !important; }
            .mobile-cta-bar { display: flex !important; }
            body.has-mobile-cta { padding-bottom: 68px; }
            .hero-stats { gap: 10px !important; justify-content: space-between !important; }
            .hero-stats .stat-value { font-size: 16px !important; }
            .hero-stats .stat-label { font-size: 9px !important; }
            .how-it-works-grid { grid-template-columns: repeat(3, 1fr) !important; gap: 10px !important; }
            .how-it-works-grid .step-circle { width: 34px !important; height: 34px !important; font-size: 13px !important; margin-bottom: 8px !important; }
            .how-it-works-grid .step-title { font-size: 11.5px !important; margin-bottom: 4px !important; }
            .how-it-works-grid .step-desc { font-size: 9.5px !important; line-height: 1.35 !important; }
            .floating-cta { bottom: 84px !important; width: 52px !important; height: 52px !important; }
            .footer-section { padding-top: 32px !important; padding-bottom: 18px !important; }
            .footer-section .footer-grid { gap: 26px 20px !important; padding-bottom: 22px !important; }
            .footer-section .footer-col-title { font-size: 11.5px !important; margin-bottom: 10px !important; }
            .footer-section .footer-links { gap: 8px !important; font-size: 12.5px !important; }
            .footer-section .footer-brand-desc { font-size: 12.5px !important; }
        }
    </style>
