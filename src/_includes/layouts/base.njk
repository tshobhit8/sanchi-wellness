<!-- Mobile Sticky CTA Bar -->
<div class="mobile-cta-bar fixed bottom-0 left-0 right-0 hidden bg-card border-t border-hairline px-4 py-2.5 gap-2.5 z-50 shadow-[0_-8px_24px_rgba(0,0,0,0.1)]">
<a class="flex-1 bg-accent text-white text-center py-3 rounded-lg no-underline font-bold text-sm" href="tel:+917351189757">Call Now</a>
<a class="flex-1 bg-accent-light text-accent-text-dark text-center py-3 rounded-lg no-underline font-bold text-sm" href="https://wa.me/917351189757?text=Hi%2C%20I%27d%20like%20to%20know%20more%20about%20Sanchi%20Nutrition%20%26%20Wellness%20programs." rel="noopener" target="_blank">WhatsApp</a>
</div>
<!-- Floating Book-Consultation Button -->
<a aria-label="Book free consultation" class="floating-cta fixed right-5 bottom-6 z-40 bg-accent text-white rounded-full w-14 h-14 flex items-center justify-center shadow-[0_10px_28px_rgba(0,0,0,0.25)] no-underline hover:opacity-90 transition-opacity" href="#lead-form" id="floating-cta">
<span class="material-symbols-outlined text-2xl">edit_calendar</span>
</a>
<script>
  (function () {
    var toggle = document.getElementById('mobile-menu-toggle');
    var menu = document.getElementById('mobile-menu');
    var icon = document.getElementById('mobile-menu-icon');
    var header = document.querySelector('.site-header');
    function positionMenu() {
      if (header) { menu.style.top = header.getBoundingClientRect().bottom + 'px'; }
    }
    if (toggle && menu) {
      toggle.addEventListener('click', function () {
        var isOpen = !menu.classList.contains('hidden');
        if (!isOpen) { positionMenu(); }
        menu.classList.toggle('hidden');
        toggle.setAttribute('aria-expanded', String(!isOpen));
        icon.textContent = isOpen ? 'menu' : 'close';
      });
      window.addEventListener('resize', positionMenu);
      menu.querySelectorAll('a').forEach(function (link) {
        link.addEventListener('click', function () {
          menu.classList.add('hidden');
          toggle.setAttribute('aria-expanded', 'false');
          icon.textContent = 'menu';
        });
      });
    }
  })();

  // Floating CTA: link to the in-page lead form if one exists, else the homepage's
  (function () {
    var fab = document.getElementById('floating-cta');
    if (fab && !document.getElementById('lead-form')) { fab.setAttribute('href', '/#lead-form'); }
  })();

  // FAQ Accordion — single-open-at-a-time
  var faqItems = document.querySelectorAll('.faq-item');
  faqItems.forEach(function (item) {
    var button = item.querySelector('.faq-button');
    if (!button) return;
    button.addEventListener('click', function () {
      var isActive = item.classList.contains('active');
      faqItems.forEach(function (other) { other.classList.remove('active'); });
      if (!isActive) { item.classList.add('active'); }
    });
  });

  // Testimonial carousel — single card at a time, auto-advancing, swipeable, wraps both ends
  var carousel = document.getElementById('testimonial-carousel');
  if (carousel) {
    var track = carousel.querySelector('.carousel-track');
    var cards = Array.from(track.children);
    var count = cards.length;
    var current = 0;
    var dotsWrap = carousel.querySelector('.carousel-dots');
    var dots = [];
    var autoplayTimer = null;
    for (var i = 0; i < count; i++) {
      var d = document.createElement('span');
      d.className = 'w-2 h-2 rounded-full cursor-pointer transition-colors';
      d.addEventListener('click', (function (idx) { return function () { goTo(idx); restartAutoplay(); }; })(i));
      dotsWrap.appendChild(d);
      dots.push(d);
    }
    function render() {
      dots.forEach(function (d, idx) {
        d.style.background = idx === current ? 'var(--color-accent)' : 'var(--color-hairline)';
      });
    }
    function goTo(idx) {
      current = (idx + count) % count;
      cards[current].scrollIntoView({ behavior: 'smooth', inline: 'start', block: 'nearest' });
      render();
    }
    function startAutoplay() {
      autoplayTimer = setInterval(function () { goTo(current + 1); }, 4500);
    }
    function restartAutoplay() {
      if (autoplayTimer) clearInterval(autoplayTimer);
      startAutoplay();
    }
    var prevBtn = carousel.querySelector('.carousel-prev');
    var nextBtn = carousel.querySelector('.carousel-next');
    if (prevBtn) prevBtn.addEventListener('click', function () { goTo(current - 1); restartAutoplay(); });
    if (nextBtn) nextBtn.addEventListener('click', function () { goTo(current + 1); restartAutoplay(); });
    // Keep dots in sync when the user swipes/scrolls the track manually
    var scrollTimeout;
    track.addEventListener('scroll', function () {
      clearTimeout(scrollTimeout);
      scrollTimeout = setTimeout(function () {
        var idx = Math.round(track.scrollLeft / track.clientWidth);
        current = Math.max(0, Math.min(count - 1, idx));
        render();
      }, 100);
    });
    track.addEventListener('pointerdown', function () { if (autoplayTimer) clearInterval(autoplayTimer); });
    track.addEventListener('pointerup', restartAutoplay);
    render();
    startAutoplay();
  }
</script>
</body>
</html>
