<style>
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }
        html { scroll-behavior: smooth; }
        .card-border {
            border: 1px solid #E7E2D7;
        }
        .soft-shadow {
            box-shadow: 0px 4px 20px rgba(18, 60, 92, 0.08);
        }
        .text-gradient {
            background: linear-gradient(90deg, #5B8C3A, #C9922E);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        .faq-answer {
            max-height: 0;
            overflow: hidden;
            transition: max-height 0.3s ease-out, opacity 0.3s ease-out, padding 0.3s ease-out;
            opacity: 0;
            padding-top: 0;
            padding-bottom: 0;
        }
        .faq-item.active .faq-answer {
            max-height: 500px;
            opacity: 1;
            padding-top: 8px;
            padding-bottom: 24px;
        }
        .faq-item.active .material-symbols-outlined.expand-icon {
            transform: rotate(180deg);
        }
        .expand-icon {
            transition: transform 0.3s ease;
        }
    </style>
{% if jsonld %}
{{ jsonld | safe }}
{% endif %}
</head>
<body class="bg-background text-on-surface font-body-md antialiased">
{% include "partials/header.njk" %}
<main>
{{ content | safe }}
</main>
{% include "partials/footer.njk" %}
<script>
  (function () {
    var toggle = document.getElementById('mobile-menu-toggle');
    var menu = document.getElementById('mobile-menu');
    var icon = document.getElementById('mobile-menu-icon');
    if (toggle && menu) {
      toggle.addEventListener('click', function () {
        var isOpen = !menu.classList.contains('hidden');
        menu.classList.toggle('hidden');
        toggle.setAttribute('aria-expanded', String(!isOpen));
        icon.textContent = isOpen ? 'menu' : 'close';
      });
      menu.querySelectorAll('a').forEach(function (link) {
        link.addEventListener('click', function () {
          menu.classList.add('hidden');
          toggle.setAttribute('aria-expanded', 'false');
          icon.textContent = 'menu';
        });
      });
    }
  })();

  // FAQ Accordion Logic (only present on the homepage)
  var faqItems = document.querySelectorAll('.faq-item');
  faqItems.forEach(function (item) {
    var button = item.querySelector('.faq-button');
    if (!button) return;
    button.addEventListener('click', function () {
      var isActive = item.classList.contains('active');
      faqItems.forEach(function (other) { other.classList.remove('active'); });
      if (!isActive) { item.classList.add('active'); }
    });
  });
</script>
</body>
</html>
