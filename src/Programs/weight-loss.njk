<script>
  (function () {
    const scriptURL = 'https://script.google.com/macros/s/AKfycbxntbgS4pcmNaob3IMRXtblOp45zZ3CxJpJTXesFrT-UCItr7An6Lo6XCa1HR7EbBqP/exec';
    const form = document.getElementById('leadFormWeightLoss');
    const btn = document.getElementById('submitBtnWeightLoss');
    form.addEventListener('submit', function (e) {
      e.preventDefault();
      btn.disabled = true;
      btn.innerText = 'Submitting...';
      fetch(scriptURL, { method: 'POST', body: new FormData(form) })
        .then(function () {
          alert('Thank you! Your details have been submitted.');
          form.reset();
          btn.disabled = false;
          btn.innerText = 'Get Free Consultation';
        })
        .catch(function () {
          alert('Something went wrong. Please try again.');
          btn.disabled = false;
          btn.innerText = 'Get Free Consultation';
        });
    });
  })();
</script>
